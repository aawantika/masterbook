<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hourly auto-deploy for the host machine. This is a TEMPLATE -- fill in
  your own username/path before installing:
    1. Replace YOUR_USERNAME below with your actual macOS username (twice).
    2. cp scripts/com.masterbook.deploy.plist ~/Library/LaunchAgents/
    3. launchctl load ~/Library/LaunchAgents/com.masterbook.deploy.plist
  Log ends up at ~/Library/Logs/masterbook-deploy.log on whatever machine
  you install it on.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.masterbook.deploy</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/YOUR_USERNAME/masterbook/scripts/deploy.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>StandardOutPath</key>
  <string>/Users/YOUR_USERNAME/Library/Logs/masterbook-deploy.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/Library/Logs/masterbook-deploy.log</string>
</dict>
</plist>
