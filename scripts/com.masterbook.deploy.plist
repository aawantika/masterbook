<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hourly auto-deploy for the host machine. Install (paths assume the repo
  is cloned at ~/masterbook -- edit both if not):
    cp scripts/com.masterbook.deploy.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.masterbook.deploy.plist
  Log: ~/Library/Logs/masterbook-deploy.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.masterbook.deploy</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/aawantika/masterbook/scripts/deploy.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>StandardOutPath</key>
  <string>/Users/aawantika/Library/Logs/masterbook-deploy.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/aawantika/Library/Logs/masterbook-deploy.log</string>
</dict>
</plist>
